# Copy to .env to change where compose looks for things.
# Folder with your own videos (mounted read only).
VIDEOS_DIR=./videos
# Only the console port is published by default. scripts/start.sh picks a free one for you.
# The others are published by compose.ports.yaml. Change one if another program already uses it.
# CORE_PORT=8000
# DETECTOR_PORT=8300
# AGENCIES_PORT=9100
# SMS_PORT=9200
# MQTT_PORT=1883
# AMQP_PORT=5672
# RABBIT_UI_PORT=15672
