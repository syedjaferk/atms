# Copy to .env to change where compose looks for things.
# Folder with your own videos (mounted read only).
VIDEOS_DIR=./videos
# Reuse the AI models already downloaded on this machine, so the detector does not download them again.
# HF_CACHE=/home/you/.cache/huggingface

# Ports published on this machine. Change one if another program already uses it ("port is already allocated").
# CORE_PORT=8000
# DETECTOR_PORT=8300
# AGENCIES_PORT=9100
# SMS_PORT=9200
# MQTT_PORT=1883
# AMQP_PORT=5672
# RABBIT_UI_PORT=15672
