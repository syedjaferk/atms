{
  "$defs": {
    "IncidentUpdatedData": {
      "additionalProperties": false,
      "description": "A later detection was merged into an open incident.",
      "properties": {
        "affected_lanes": {
          "items": {
            "type": "string"
          },
          "title": "Affected Lanes",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "detection_event_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Detection Event Ids",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "reason",
        "confidence",
        "severity",
        "affected_lanes",
        "detection_event_ids"
      ],
      "title": "IncidentUpdatedData",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "minor",
        "major",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "$id": "https://atms.local/events/incident.updated.schema.json",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/IncidentUpdatedData"
    },
    "dedup_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dedup Key"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "incident_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Incident Id"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "producer": {
      "title": "Producer",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    },
    "type": {
      "const": "incident.updated",
      "default": "incident.updated",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "producer",
    "data"
  ],
  "title": "IncidentUpdated",
  "type": "object"
}
