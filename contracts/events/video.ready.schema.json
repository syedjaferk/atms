{
  "$defs": {
    "VideoReadyData": {
      "additionalProperties": false,
      "properties": {
        "camera_id": {
          "title": "Camera Id",
          "type": "string"
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "video_ref": {
          "title": "Video Ref",
          "type": "string"
        }
      },
      "required": [
        "camera_id",
        "video_ref",
        "duration_s",
        "size_bytes",
        "sha256"
      ],
      "title": "VideoReadyData",
      "type": "object"
    }
  },
  "$id": "https://atms.local/events/video.ready.schema.json",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/VideoReadyData"
    },
    "dedup_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dedup Key"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "incident_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Incident Id"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "producer": {
      "title": "Producer",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    },
    "type": {
      "const": "video.ready",
      "default": "video.ready",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "producer",
    "data"
  ],
  "title": "VideoReady",
  "type": "object"
}
