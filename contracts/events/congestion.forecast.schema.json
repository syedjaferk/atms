          "type": "number"
        },
        "high_kmh": {
          "title": "High Kmh",
          "type": "number"
        },
        "horizon_min": {
          "minimum": 1,
          "title": "Horizon Min",
          "type": "integer"
        },
        "level": {
          "enum": [
            "heavy",
            "severe"
          ],
          "title": "Level",
          "type": "string"
        },
        "low_kmh": {
          "title": "Low Kmh",
          "type": "number"
        },
        "main_factor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Main Factor"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "predicted_speed_kmh": {
          "minimum": 0,
          "title": "Predicted Speed Kmh",
          "type": "number"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "horizon_min",
        "level",
        "predicted_speed_kmh",
        "low_kmh",
        "high_kmh",
        "free_flow_kmh",
        "model_version"
      ],
      "title": "CongestionForecastData",
      "type": "object"
    }
