{
  "$defs": {
    "IncidentCreatedData": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "detection_event_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Detection Event Ids",
          "type": "array"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "road_segment": {
          "title": "Road Segment",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "state": {
          "$ref": "#/$defs/IncidentState"
        }
      },
      "required": [
        "state",
        "severity",
        "confidence",
        "location",
        "road_segment",
        "detection_event_ids"
      ],
      "title": "IncidentCreatedData",
      "type": "object"
    },
    "IncidentState": {
      "enum": [
        "detected",
        "verified",
        "rejected",
        "dispatching",
        "dispatched",
        "in_progress",
        "clearing",
        "resolved",
        "closed"
      ],
      "title": "IncidentState",
      "type": "string"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "Location",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "minor",
        "major",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "$id": "https://atms.local/events/incident.created.schema.json",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/IncidentCreatedData"
    },
    "dedup_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dedup Key"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "incident_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Incident Id"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "producer": {
      "title": "Producer",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    },
    "type": {
      "const": "incident.created",
      "default": "incident.created",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "producer",
    "data"
  ],
  "title": "IncidentCreated",
  "type": "object"
}
